    "verify-split": "node --experimental-strip-types scripts/verify-split.mjs"
  },
  "peerDependencies": {
    "three": ">=0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.185.1",
    "typescript": "~6.0.2"
  }
