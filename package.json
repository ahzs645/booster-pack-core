{
  "name": "@tcg/pack-core",
  "version": "0.1.0",
  "description": "Shared booster-pack mesh, cover sheets and UV layout, consumed by booster-pack-studio and TCGer",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./experience": "./src/experience/index.ts",
    "./assets/*": "./assets/*"
  },
  "files": [
    "src",
    "assets",
    "scripts"
  ],
  "scripts": {
    "build:embed": "node scripts/build-embed.mjs",
    "sync-assets": "node scripts/sync-assets.mjs",
    "pretypecheck": "npm run verify-assets",
    "typecheck": "tsc --noEmit",
    "verify-backwards-reveal": "node --experimental-strip-types scripts/verify-backwards-reveal.mjs",
    "verify-card-visibility": "node --experimental-strip-types scripts/verify-card-visibility.mjs",
    "verify-assets": "node scripts/verify-assets.mjs",
    "verify-split": "node --experimental-strip-types scripts/verify-split.mjs"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "three": ">=0.180.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.27",
    "esbuild": "^0.27.4",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.18",
    "three": "^0.185.1",
    "typescript": "~6.0.2"
  }
}
