{
  "name": "@tcg/pack-core",
  "version": "0.1.0",
  "description": "Shared booster-pack mesh, cover sheets and UV layout, consumed by booster-pack-studio and TCGer",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
